# Copie para .env. NUNCA compartilhe o .env ou chaves reais.
PORT=3000
AI_MODE=live
OPENAI_API_KEY=coloque_sua_chave_aqui
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=25000
# Usado pelo n8n nas requisicoes internas a API
API_ACCESS_KEY=troque_por_um_segredo_longo_e_aleatorio
# Gere uma chave longa e aleatoria unica antes de executar o Docker Compose
N8N_ENCRYPTION_KEY=troque_por_uma_chave_aleatoria_longa
# Pasta onde os protocolos sao gravados no modo local
DATA_DIR=./data
