      "id": "19e567ae-40f6-506d-bf22-84888ce1930b",
      "name": "01 - Receber solicitacao",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -760,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json.body ?? {};\nif (typeof body.descricao !== 'string' || body.descricao.trim().length < 15) {\n  throw new Error('Informe descricao com pelo menos 15 caracteres.');\n}\nreturn [{json: {\n  id: body.id || `SOL-${Date.now()}`,\n  descricao: body.descricao,\n  unidade: body.unidade || '',\n  origem: body.origem || 'n8n-webhook'\n}}];"
      },
      "id": "1de0d299-f27c-5753-98d9-a471415503ff",
      "name": "02 - Validar e normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -490,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:3000/api/analisar",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "761f9785-248a-54d1-a4a8-adbc112fe38e",
      "name": "03 - API Express + IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -210,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const entrada = $input.first().json;\nif (!entrada.decisao?.fila || !entrada.solicitacao?.id) {\n  throw new Error('API nao retornou os campos de triagem esperados.');\n}\nconst d = entrada.decisao;\nreturn [{json: {\n  solicitacao_id: entrada.solicitacao.id,\n  resumo: entrada.classificacao_ia.resumo,\n  setor: d.setor,\n  fila: d.fila,\n  prioridade: d.prioridade,\n  categoria: d.categoria,\n  status: d.status,\n  revisao_humana: d.revisao_humana\n}}];"
      },
      "id": "a623065a-bda6-5a31-a8e6-9dc5e31c7963",
      "name": "04 - Definir fila setorial",
